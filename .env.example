# Payload database. Point local and preview at a development database.
DATABASE_URL=postgres://user:pass@dev-host.example/db
# Hosts that count as production (comma-separated). Writing them needs ALLOW_PRODUCTION_DB=true per command.
PRODUCTION_DB_HOSTS=prod-host.example
# Public site for link checks, cache purges and image downloads.
BLOG_PUBLIC_ORIGIN=https://www.example.com
# Same value as in the hosting provider's production environment.
REVALIDATE_SECRET=
# https://www.pexels.com/api/
PEXELS_API_KEY=
